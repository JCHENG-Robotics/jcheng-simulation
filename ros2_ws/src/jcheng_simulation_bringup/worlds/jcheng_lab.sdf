<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal offline lab for the v0.1 arm plant. No Fuel downloads, no network:
  the ground, table and target cube are inline SDF primitives.
-->
<sdf version="1.9">
  <world name="jcheng_lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <ambient>0.55 0.55 0.55 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.30 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry>
            <box>
              <size>0.42 0.50 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="top">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry>
            <box>
              <size>0.42 0.50 0.02</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.55 0.40 0.25 1</diffuse>
            <ambient>0.55 0.40 0.25 1</ambient>
          </material>
        </visual>
        <collision name="pedestal">
          <pose>0 0 0.115 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.23</size>
            </box>
          </geometry>
        </collision>
        <visual name="pedestal">
          <pose>0 0 0.115 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.23</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.35 0.35 1</diffuse>
            <ambient>0.35 0.35 0.35 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_cube">
      <pose>0.30 0.0 0.27 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.85 0.15 0.15 1</diffuse>
            <ambient>0.85 0.15 0.15 1</ambient>
          </material>
        </visual>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>5.333e-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>5.333e-06</iyy>
            <iyz>0</iyz>
            <izz>5.333e-06</izz>
          </inertia>
        </inertial>
      </link>
    </model>
  </world>
</sdf>
