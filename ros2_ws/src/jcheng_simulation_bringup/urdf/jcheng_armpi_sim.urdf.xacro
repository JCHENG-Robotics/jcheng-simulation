<?xml version="1.0" encoding="utf-8"?>
<!--
  PROVISIONAL PRIMITIVE-GEOMETRY SIMULATION MODEL.

  This is NOT the vendor mesh model and NOT a hardware-validated geometric
  model. Link lengths are simplified; joint names, axes and position limits
  follow the frozen jcheng-manipulation baseline
  (armpi_ultra_description/urdf/armpi_ultra.xacro, 2026-11-18). The second
  gripper finger (l_joint, mimic -1 x r_joint) is omitted in v0.1 and is added
  in M2. The wrist camera mount is nominal.

  Simulation-only command velocity is 1.5 rad/s; the vendor URDF's
  velocity="10" and effort="1000" are placeholders, not measurements.

  This file contains no vendor mesh or vendor source. Use the vendor
  description package read-only if mesh geometry is needed for a separate
  check.
-->
<robot name="jcheng_armpi_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_yaml" default="$(find jcheng_simulation_bringup)/config/controllers.yaml"/>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 ${length/2.0}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(3.0*radius*radius + length*length)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass*(3.0*radius*radius + length*length)/12.0}" iyz="0.0"
        izz="${mass*radius*radius/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass*(x*x + z*z)/12.0}" iyz="0.0"
        izz="${mass*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
      <material name="jcheng_blue">
        <color rgba="0.20 0.35 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.60" x="0.14" y="0.14" z="0.06"/>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.0375" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.075"/>
      </geometry>
      <material name="jcheng_grey">
        <color rgba="0.75 0.78 0.82 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0375" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.075"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.15" radius="0.022" length="0.075"/>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8012" upper="1.8012" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.12" radius="0.020" length="0.10"/>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.6618" upper="1.1519" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.0475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.095"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.095"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.10" radius="0.018" length="0.095"/>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.8012" upper="0.0" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.056"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.056"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.08" radius="0.016" length="0.056"/>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.095" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5917" upper="1.5917" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="link5">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.06"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.06" radius="0.014" length="0.06"/>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.056" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5917" upper="1.5499" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.03"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.03" x="0.03" y="0.05" z="0.03"/>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="link5"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="r_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.006 0.04"/>
      </geometry>
      <material name="jcheng_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.006 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.005" x="0.012" y="0.006" z="0.04"/>
  </link>

  <joint name="r_joint" type="revolute">
    <parent link="gripper_link"/>
    <child link="r_link"/>
    <origin xyz="0 0.02 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.22" upper="0.0" velocity="1.5" effort="10.0"/>
  </joint>

  <link name="end_effector_link"/>

  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="jcheng_dark">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.05" radius="0.035" length="0.03"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="jcheng_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.01" x="0.03" y="0.03" z="0.02"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="link4"/>
    <child link="camera_link"/>
    <origin xyz="0.035 0 0.04" rpy="0 0.8 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <!-- gz_ros2_control: the controller_manager runs inside Gazebo. The /sim
       namespace keeps joint_states and controller actions inside the
       simulation namespace. -->
  <ros2_control name="JchengSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="r_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <namespace>/sim</namespace>
        <!-- The controller_manager subscribes to robot_description in its own
             namespace; remap it to the un-namespaced topic published by
             robot_state_publisher. -->
        <remapping>robot_description:=/robot_description</remapping>
      </ros>
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>
      <diffuse>0.20 0.35 0.75 1</diffuse>
      <ambient>0.20 0.35 0.75 1</ambient>
    </material>
  </gazebo>
  <gazebo reference="link1">
    <material>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <ambient>0.75 0.78 0.82 1</ambient>
    </material>
  </gazebo>
  <gazebo reference="link2">
    <material>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <ambient>0.75 0.78 0.82 1</ambient>
    </material>
  </gazebo>
  <gazebo reference="link3">
    <material>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <ambient>0.75 0.78 0.82 1</ambient>
    </material>
  </gazebo>
  <gazebo reference="link4">
    <material>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <ambient>0.75 0.78 0.82 1</ambient>
    </material>
  </gazebo>
  <gazebo reference="link5">
    <material>
      <diffuse>0.75 0.78 0.82 1</diffuse>
      <ambient>0.75 0.78 0.82 1</ambient>
    </material>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="wrist_camera" type="camera">
      <topic>camera/image</topic>
      <camera_info_topic>camera/camera_info</camera_info_topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
